# ====================================
# MJMovies — .env RAÍZ (Docker Compose)
# Copia como .env y configura tus valores
# ====================================

# Base de datos MySQL
DB_NAME=mjmovies
DB_USER=mjmovies_user
DB_PASSWORD=CambiaEsto_MySQL_Password_123!
DB_ROOT_PASSWORD=CambiaEsto_Root_Password_456!

# Redis
REDIS_PASSWORD=CambiaEsto_Redis_Password_789!

# JWT — genera con: openssl rand -hex 64
JWT_ACCESS_SECRET=genera_un_secreto_muy_largo_aqui_con_openssl_rand_hex_64_minimo
JWT_REFRESH_SECRET=genera_otro_secreto_diferente_aqui_con_openssl_rand_hex_64_minimo

# Cookies
COOKIE_SECRET=otro_secreto_para_cookies_diferente_a_jwt_openssl_rand_hex_32

# CORS — URLs del frontend (separa con coma si hay más de una)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://tu-ip-del-servidor
FRONTEND_URL=http://localhost

# Admin inicial (se crea automáticamente en el primer deploy)
ADMIN_EMAIL=admin@mjmovies.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@MJMovies2024!

# Tamaño máximo de subida en MB (default 5000 = 5GB)
MAX_FILE_SIZE_MB=5000
