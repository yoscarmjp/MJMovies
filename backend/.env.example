# ====================================
# MJMovies — Variables de Entorno
# Copia este archivo como .env y configura tus valores
# ====================================

# Entorno
NODE_ENV=development
PORT=5000

# ====================================
# BASE DE DATOS MYSQL
# ====================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mjmovies
DB_USER=mjmovies_user
DB_PASSWORD=TuPasswordSeguro123!
DATABASE_URL="mysql://mjmovies_user:TuPasswordSeguro123!@mysql:3306/mjmovies"

# ====================================
# REDIS
# ====================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=RedisPassword456!
REDIS_URL="redis://:RedisPassword456!@redis:6379"

# ====================================
# JWT - GENERA CON: node -e "require('crypto').randomBytes(64).toString('hex')"
# ====================================
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio_64bytes_minimo
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_diferente_64bytes_minimo
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ====================================
# CORS - URLs permitidas (separadas por coma)
# ====================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ====================================
# ALMACENAMIENTO
# ====================================
UPLOADS_DIR=/app/uploads
STREAMS_DIR=/app/streams
POSTERS_DIR=/app/posters
MAX_FILE_SIZE_MB=5000

# ====================================
# FFMPEG (en Linux ya está instalado)
# ====================================
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ====================================
# RATE LIMITING
# ====================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000

# ====================================
# SESIONES / SEGURIDAD
# ====================================
COOKIE_SECRET=otro_secreto_para_cookies_diferente_a_jwt
CSRF_SECRET=secreto_csrf_tambien_diferente

# ====================================
# ADMIN INICIAL (se crea en seed)
# ====================================
ADMIN_EMAIL=admin@mjmovies.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@MJMovies2024!

# ====================================
# FRONTEND URL (para CORS y emails)
# ====================================
FRONTEND_URL=http://localhost:3000

# ====================================
# EMAIL (opcional - para verificación)
# ====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=tu_app_password
EMAIL_FROM=MJMovies <noreply@mjmovies.local>
