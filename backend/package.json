{
  "name": "mjmovies-backend",
  "version": "1.0.0",
  "description": "MJMovies Backend API — Secure Streaming Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node prisma/sync-schema.js && nodemon --watch src --ext js,json src/server.js",
    "start": "node prisma/sync-schema.js && node src/server.js",
    "postinstall": "node prisma/sync-schema.js",
    "db:sync": "node prisma/sync-schema.js",
    "db:generate": "node prisma/sync-schema.js && prisma generate",
    "db:migrate": "node prisma/sync-schema.js && prisma migrate deploy",
    "db:push": "node prisma/sync-schema.js && prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.3",
    "slugify": "^1.6.6",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.33.4",
    "socket.io": "^4.7.5",
    "uuid": "^11.0.5",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.14.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
