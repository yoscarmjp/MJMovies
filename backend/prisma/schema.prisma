// This is your Prisma schema file for MJMovies (MySQL)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ====================================
// USUARIOS Y AUTENTICACIÓN
// ====================================

model User {
  id           String   @id @default(uuid()) @db.VarChar(36)
  email        String   @unique @db.VarChar(255)
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  isVerified   Boolean  @default(false) @map("is_verified")
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  // Relaciones
  refreshTokens RefreshToken[]
  watchHistory  WatchHistory[]
  remoteSessions RemoteSession[]

  @@index([email])
  @@index([username])
  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

// ====================================
// PELÍCULAS Y CONTENIDO
// ====================================

model Movie {
  id             String        @id @default(uuid()) @db.VarChar(36)
  title          String        @db.VarChar(255)
  slug           String        @unique @db.VarChar(255)
  description    String?       @db.Text
  year           Int?
  duration       Int?          // en segundos
  rating         Decimal?      @db.Decimal(3, 1)
  director       String?       @db.VarChar(255)
  cast           Json?         // Array de nombres
  posterUrl      String?       @map("poster_url") @db.VarChar(500)
  backdropUrl    String?       @map("backdrop_url") @db.VarChar(500)
  trailerUrl     String?       @map("trailer_url") @db.VarChar(500)
  streamPath     String?       @map("stream_path") @db.VarChar(500) // Ruta a master.m3u8
  originalFile   String?       @map("original_file") @db.VarChar(500)
  fileSize       BigInt?       @map("file_size")
  status         MovieStatus   @default(PENDING)
  featured       Boolean       @default(false)
  views          Int           @default(0)
  language       String?       @db.VarChar(10) @default("es")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relaciones
  genres         MovieGenre[]
  transcodeJobs  TranscodeJob[]
  watchHistory   WatchHistory[]

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@fulltext([title, description])
  @@map("movies")
}

enum MovieStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

model Genre {
  id     String       @id @default(uuid()) @db.VarChar(36)
  name   String       @unique @db.VarChar(100)
  slug   String       @unique @db.VarChar(100)
  movies MovieGenre[]

  @@map("genres")
}

model MovieGenre {
  movieId String @map("movie_id") @db.VarChar(36)
  genreId String @map("genre_id") @db.VarChar(36)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("movie_genres")
}

// ====================================
// TRANSCODIFICACIÓN
// ====================================

model TranscodeJob {
  id          String       @id @default(uuid()) @db.VarChar(36)
  movieId     String       @map("movie_id") @db.VarChar(36)
  status      JobStatus    @default(QUEUED)
  progress    Int          @default(0)  // 0-100
  quality     String?      @db.VarChar(20) // "360p,720p,1080p"
  errorMsg    String?      @map("error_msg") @db.Text
  startedAt   DateTime?    @map("started_at")
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([status])
  @@map("transcode_jobs")
}

enum JobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

// ====================================
// HISTORIAL Y SESIONES
// ====================================

model WatchHistory {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  movieId   String   @map("movie_id") @db.VarChar(36)
  position  Int      @default(0) // segundos
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@map("watch_history")
}

model RemoteSession {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  tvSessionId String   @map("tv_session_id") @db.VarChar(100)
  socketId    String?  @map("socket_id") @db.VarChar(100)
  pairingCode String   @map("pairing_code") @db.VarChar(10)
  isConnected Boolean  @default(false) @map("is_connected")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pairingCode])
  @@index([tvSessionId])
  @@map("remote_sessions")
}
